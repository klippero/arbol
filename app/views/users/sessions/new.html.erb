<div class="auth-page">
  <div class="card">
    <div class="logo">
      <%= image_tag "arbol.jpg", alt: "" %>
      <span class="logo-texto">Árbol<br>genealógico</span>
    </div>

    <h2>Iniciar sesión</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email, "Correo electrónico" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :password, "Contraseña" %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "Recordarme" %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Entrar", class: "btn" %>
      </div>
    <% end %>

    <div class="enlaces">
      <% if devise_mapping.registerable? %>
        <%= link_to "Crear cuenta", new_registration_path(resource_name) %>
      <% end %>
      <% if devise_mapping.recoverable? %>
        <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name) %>
      <% end %>
    </div>

    <div style="text-align:center;margin-top:20px;">
      <%= link_to "v4.0", tree_versiones_path, class: "nav-menu-version" %>
    </div>
  </div>
</div>
