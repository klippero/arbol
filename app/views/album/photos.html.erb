<header>
<div class="familia">
<h1><%= image_tag('arbol.jpg', :width => '64') %><%= @p.fullname %></h1>
</div>
<nav><ul><li><a href=index.html>listado</a></li></ul></nav>
</header>

<% if @p %>

  <div class="nacimientoYdefuncion">
  <%= @p.dates %>
  </div>

<div class="progenitores">

  <% if @f.consorts.length > 0 %>

    <% if !@f.consorts[0].childrenof.blank? %>
      <a href=?id=<%= @f.consorts[0].childrenof.id %>>
    <% end %>
    <div class="progenitor">
      <div class="nombreApellidos">
        <%= @f.consorts[0].fullname %>
      </div>
      <div class="nacimientoYdefuncion">
        <%= @f.consorts[0].dates %>
      </div>
      <% if @f.consorts[0].childrenof && @f.consorts[0].childrenof.consorts.length > 0 %>
        <div class="abuelos">
          <%= @f.consorts[0].childrenof.consorts[0].name %>
          <% if @f.consorts[0].childrenof.consorts.length > 1 %>
            <%= image_tag('anillos.gif', :width => '18') %>
            <%= @f.consorts[0].childrenof.consorts[1].name %>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if !@f.consorts[0].childrenof.blank? %>
      </a>
    <% end %>
  <% end %>

  <% if @f.consorts.length > 1 %>
    <div class="enlace">
      <%= image_tag('anillos.gif', :width => '22') %>
      <% if @f.marriagedate %>
        <br>
        <span class=bodaTitulo>
        <%= IncompleteDate.new(date:@f.marriagedate,accurate:@f.marriagedateAcc).to_s %>
        </span>
      <% end %>
    </div>

    <% if !@f.consorts[1].childrenof.blank? %>
      <a href=?id=<%= @f.consorts[1].childrenof.id %>>
    <% end %>
    <div class="progenitor">
      <div class="nombreApellidos">
        <%= @f.consorts[1].fullname %>
      </div>
      <div class="nacimientoYdefuncion">
        <%= @f.consorts[1].dates %>
      </div>
      <% if @f.consorts[1].childrenof && @f.consorts[1].childrenof.consorts.length > 0 %>
        <div class="abuelos">
          <%= @f.consorts[1].childrenof.consorts[0].name %>
          <% if @f.consorts[1].childrenof.consorts.length > 1 %>
            <%= image_tag('anillos.gif', :width => '18') %>
            <%= @f.consorts[1].childrenof.consorts[1].name %>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if !@f.consorts[1].childrenof.blank? %>
      </a>
    <% end %>
  <% end %>

</div>

<div class="hijos">

<% @f.children.sort_by { |a| a[:birthorder]?a[:birthorder]:99 }.each do |son| %>
  <% if son.consortof && son.consortof.length == 1 %>
    <a href=?id=<%= son.consortof[0].id %>>
  <% end %>
  <div class="hijo">
    <div class="orden"><%= son.birthorder %></div>
    <div class="hijoNombre"><%= son.name %></div>
    <div class="hijoFecha"><%= son.dates %></div>
    <% if son.consortof && son.consortof.length == 1 %>
      <div class="conyuge">
        <%= image_tag('anillos.gif', :width => '18') %>
        <%= son.consortof[0].otherconsort( son ) %>
      </div>
    <% elsif son.consortof && son.consortof.length > 1 %>
      <% son.consortof.each do |family| %>
        <a href=?id=<%= family.id %>>
        <div class="conyuge">
          <%= image_tag('anillos.gif', :width => '18') %>
          <%= family.otherconsort( son ) %>
        </div>
        </a>
      <% end %>
    <% end %>
  </div>
  <% if son.consortof && son.consortof.length == 1 %>
    </a>
  <% end %>
<% end %>

</div>



  <% @p.consortof.each do |family| %>
    <%= image_tag('anillos.gif', :width => '18') %>
    <%= family.otherconsort(@p) %>
    <% family.children.sort_by { |a| a[:birthorder]?a[:birthorder]:99 }.each do |son| %>
      <a href=?p=<%= son.id %>>
      <li><%= son.fullNameDatesNoPhotos %></li>
      </a>
    <% end %>
  <% end %>

<% end %>


<p>

<% @photos.each do |photo| %>

<div class="tituloFoto">
  <%= photo.title %>
</div>

<% if !photo.date.blank? || !photo.place.blank? %>
<div class="fechaFoto">
  <%= IncompleteDate.new(date:photo.date,accurate:photo.dateAcc).to_s %>
  <%= photo.place %>
</div>
<% end %>

<% if !photo.content.blank? %>
<p>
  <strong>Content:</strong>
  <%= photo.content %>
</p>
<% end %>

<p>
<% if photo.image.attached? %>
<p>
<%= image_tag photo.image, style: 'max-width:100%;' %>
<% if !photo.owner.blank? %>
  <strong>Owner:</strong>
  <%= photo.owner %>
<% end %>
</p>
<% end %>
</p>

<ul>
    <% photo.people.each do |person| %>

    <a href=?p=<%= person.id %>>
    <li><%= person.fullname %><%= ( person.birthdate.nil? ? '' : ', ' + IncompleteDate.new(date:person.birthdate,accurate:person.birthdateAcc).edad(IncompleteDate.new(date:photo.date,accurate:photo.dateAcc)).to_s + ' años' ) %>
    <% if person.dates != '' %>
     (<%= person.dates %>)
    <% end %>
<%= ( person.photos.count > 1 ? person.photos.count : '' ) %>
     </li>
     </a>

    <% end %>
</ul>

<% end %>
