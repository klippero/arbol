<p><p><br><br>
<table border="5">
    <tr>
        <th>id</th>
        <th>fullname</th>
        <th>birthdate</th>
        <th>birthdateAcc</th>
        <th>dates</th>
        <th>nextBirthday</th>
        <th>days2birthday</th>
        <th>relacionCon</th>
        <th>2010-12-06 acc 7</th>
    </tr>
<% Person.where.not(birthdate: nil).sort_by(&:birthdate).each do |person| %>
    <tr>
        <td><%= person.id %></td>
        <td><%= person.fullname %></td>
        <td><%= person.birthdate %></td>
        <td><%= person.birthdateAcc %></td>
        <td><%= person.dates %></td>
        <td><%= person.nextBirthday %></td>
        <td><%= person.days2birthday %></td>
        <td><%= person.relacionCon(Person.find(7)) %></td>
        <td><%= person.fallecio? %></td>
    </tr>
<% end %>
</table>
