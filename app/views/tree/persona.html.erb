<% content_for :title, @p ? @p.fullname : 'Árbol genealógico' %>
<header>
  <div class="header-left"><%= link_to image_tag('logo.svg', width: 40), tree_fechas_path %></div>
  <div class="header-right"><%= current_user.email.split('@').first %><%= render 'nav_menu' %></div>
</header>
<h1 class="page-title"><%= @p.fullname %></h1>


    <% @person = @p %>
<%= render 'person_info' %>



<% @p.consortof.each do |familia| %>
  <div class="tituloSeccion">
  Hijos
  <% if familia.consorts.length > 1 %>
  (
  <a href=/tree/familia?f=<%= familia.id %>>
  <%= @p.name %>
  <%= image_tag('anillos.gif', :width => '18') %>
  <%= ( familia.firstOtherconsort( @p ).nil? ? '' : familia.firstOtherconsort( @p ).name ) %>
  </a>)
  <% end %>
  </div>

  <div class="hijos">

  <% familia.children.sort_by { |a| a[:birthorder]?a[:birthorder]:99 }.each do |son| %>

  <div class="hijo">
    <div class="orden"><%= son.birthorder %></div>
    <a href=?p=<%= son.id %>><div class="hijoNombre"><%= son.name %></div></a>
    <div class="hijoFecha"><%= son.dates %></div>
    <% son.consortof.each do |family| %>
      <a href=familia?f=<%= family.id %>>
      <div class="conyuge">
        <%= image_tag('anillos.gif', :width => '18') %>
        <%= family.otherconsort( son ) %>
      </div>
      </a>
    <% end %>
  </div>

  <% end %>

  </div>

<% end %>


<% if @p.photos.length > 0 %>
  <div class="tituloSeccion">
  Fotos
  </div>
  <div class="hijos">
  <% @p.photos.sort_by { |p| p.date || Date.new(0) }.each do |photo| %>
    <div class="foto">
      <div class="tituloFoto">
        <%= link_to photo.title, tree_foto_path(id: photo.id, p: @p.id) %>
      </div>
      <% if !photo.date.blank? || !photo.place.blank? %>
        <div class="fechaFoto">
          <%= IncompleteDate.new(date:photo.date,accurate:photo.dateAcc).to_s %>
          <%= photo.place %>
          <% unless @p.birthdate.nil? %>
            (<%= IncompleteDate.new(date:@p.birthdate,accurate:@p.birthdateAcc).toStr(IncompleteDate.new(date:photo.date,accurate:photo.dateAcc)) %>)
          <% end %>
        </div>
      <% end %>
      <% if photo.image.attached? %>
        <%= link_to tree_foto_path(id: photo.id, p: @p.id) do %>
          <%= image_tag photo.image, style: 'max-width:100%;max-height:100%;' %>
        <% end %>
      <% end %>
      <div class="divEnLaFoto">
      <ul class="enLaFoto">
        <% photo.people.each do |person| %>
          <a href=?p=<%= person.id %>>
            <% age = person.birthdate.nil? ? '' : IncompleteDate.new(date:person.birthdate,accurate:person.birthdateAcc).toStr(IncompleteDate.new(date:photo.date,accurate:photo.dateAcc)) %>
            <li<%= (person==@p ? ' class=prota' : '') %>><%= person.name %><%= age.blank? ? '' : ' (' + age + ')' %>
              <%= @p.relacionCon(person) %>
            </li>
          </a>
        <% end %>
      </ul>
      </div>
      <% if !photo.owner.blank? %>
        <div class="divOwner">
          Foto de <%= photo.owner %>
        </div>
      <% end %>
    </div>
  <% end %>
  </div>
<% end %>

