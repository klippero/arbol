<header>
  <div class="familia">
    <h1><%= image_tag('hoja.jpg', :width => '64') %> <%= @photo.title.presence || "Foto ##{@photo.id}" %></h1>
  </div>
  <% if @back_person || @back_family %>
    <nav>
      <ul>
        <li>
          <% if @back_person %>
            <%= link_to "← #{@back_person.fullname}", "/tree/persona?p=#{@back_person.id}" %>
          <% elsif @back_family %>
            <%= link_to "← Familia #{@back_family.name}", "/tree/familia?f=#{@back_family.id}" %>
          <% end %>
        </li>
      </ul>
    </nav>
  <% end %>
</header>

<div class="hijos">
  <div class="foto">
    <% if !@photo.date.blank? || !@photo.place.blank? %>
      <div class="fechaFoto">
        <%= IncompleteDate.new(date: @photo.date, accurate: @photo.dateAcc).to_s %>
        <%= @photo.place %>
        <% if @back_person && !@back_person.birthdate.nil? %>
          (<%= IncompleteDate.new(date:@back_person.birthdate,accurate:@back_person.birthdateAcc).toStr(IncompleteDate.new(date:@photo.date,accurate:@photo.dateAcc)) %>)
        <% end %>
      </div>
    <% end %>
    <% if !@photo.content.blank? %>
      <p><%= @photo.content %></p>
    <% end %>
    <% has_prota_contour = @back_person.present? && @photo.people_photos.any? { |pp| pp.person_id == @back_person.id && pp.display_points&.any? } %>
    <% has_other_contour = @photo.people_photos.any? { |pp| pp.person_id != @back_person&.id && pp.display_points&.any? } %>
    <%= render 'contour_mode_select', has_prota_contour: has_prota_contour, has_other_contour: has_other_contour, highlight_name: @back_person&.name %>
    <%= render 'photo_contours', photo: @photo, highlight_person: @back_person, image_link_path: nil %>
    <% if @photo.owner.present? %>
      <div class="divOwner">
        Foto de <%= @photo.owner %>
      </div>
    <% end %>
  </div>
</div>

<%= render 'contour_scripts', highlight_person_id: @back_person&.id %>
