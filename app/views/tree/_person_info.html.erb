<div class="persona-info">
  <% bd = IncompleteDate.new(date: @person.birthdate, accurate: @person.birthdateAcc) %>
  <% dd = IncompleteDate.new(date: @person.death,     accurate: @person.deathAcc) %>
  <% if @person.birthdate.present? || @person.birthplace.present? %>
    <div class="persona-info-fila">
      <span class="persona-info-label">Nacimiento</span>
      <span class="persona-info-valor">
        <%= bd.to_s %> <%= @person.birthplace %>
        <% if !@person.fallecio? && @person.birthdate.present? && @person.birthdateAcc.to_i != 0 %>
          (<%= bd.toStr %>)
        <% end %>
      </span>
    </div>
  <% end %>
  <% if @person.death.present? || @person.deathplace.present? %>
    <div class="persona-info-fila">
      <span class="persona-info-label">Defunción</span>
      <span class="persona-info-valor">
        <%= dd.to_s %> <%= @person.deathplace %>
        <% if @person.birthdate.present? && @person.birthdateAcc.to_i != 0 && @person.deathAcc.to_i != 0 %>
          (+ <%= bd.to(dd)[:str] %>)
        <% end %>
      </span>
    </div>
  <% end %>
  <% if @person.comment.present? %>
    <div class="persona-info-fila">
      <span class="persona-info-label">Nota</span>
      <span class="persona-info-valor"><%= @person.comment %></span>
    </div>
  <% end %>
  <div class="persona-info-fila" style="justify-content: flex-end;">
    <%= link_to "Apellidos", tree_apellidos_path(p: @person.id), class: "persona-info-apellidos" %>
  </div>
</div>

<% if !@person.childrenof.blank? && @person.childrenof.consorts.length > 0 %>
  <div class="tituloSeccion">Padres</div>
  <% f = @person.childrenof %>
  <div class="progenitores">

    <div class="progenitor">
      <a href=/tree/persona?p=<%= f.consorts[0].id %>>
        <div class="nombreApellidos"><%= f.consorts[0].fullname %></div>
      </a>
      <div class="nacimientoYdefuncion"><%= f.consorts[0].dates %></div>
      <% if f.consorts[0].childrenof && f.consorts[0].childrenof.consorts.length > 0 %>
        <a href=/tree/familia?f=<%= f.consorts[0].childrenof.id %>>
          <div class="abuelos">
            <%= f.consorts[0].childrenof.consorts[0].name %>
            <% if f.consorts[0].childrenof.consorts.length > 1 %>
              <%= image_tag('anillos.gif', :width => '18') %>
              <%= f.consorts[0].childrenof.consorts[1].name %>
            <% end %>
          </div>
        </a>
      <% end %>
    </div>

    <% if f.consorts.length > 1 %>
      <div class="enlace">
        <%= image_tag('anillos.gif', :width => '22') %>
        <% if f.marriagedate %>
          <br>
          <span class="bodaTitulo"><%= IncompleteDate.new(date: f.marriagedate, accurate: f.marriagedateAcc).to_s %></span>
        <% end %>
      </div>

      <div class="progenitor">
        <a href=/tree/persona?p=<%= f.consorts[1].id %>>
          <div class="nombreApellidos"><%= f.consorts[1].fullname %></div>
        </a>
        <div class="nacimientoYdefuncion"><%= f.consorts[1].dates %></div>
        <% if f.consorts[1].childrenof && f.consorts[1].childrenof.consorts.length > 0 %>
          <a href=/tree/familia?f=<%= f.consorts[1].childrenof.id %>>
            <div class="abuelos">
              <%= f.consorts[1].childrenof.consorts[0].name %>
              <% if f.consorts[1].childrenof.consorts.length > 1 %>
                <%= image_tag('anillos.gif', :width => '18') %>
                <%= f.consorts[1].childrenof.consorts[1].name %>
              <% end %>
            </div>
          </a>
        <% end %>
      </div>
    <% end %>

  </div>
<% end %>

<% if !@person.childrenof.blank? && @person.childrenof.children.length > 1 %>
  <div class="tituloSeccion">
  Hermanos
  </div>

  <div class="hijos">

  <% @person.childrenof.children.sort_by { |a| a[:birthorder]?a[:birthorder]:99 }.each do |son| %>
    <div class="hijo<%= (son.id == @person.id ? ' propio' : '') %>">
      <div class="orden"><%= son.birthorder %></div>
      <a href=/tree/persona?p=<%= son.id %>><div class="hijoNombre"><%= son.name %></div></a>
      <div class="hijoFecha"><%= son.dates %></div>
      <% son.consortof.each do |family| %>
        <a href=familia?f=<%= family.id %>>
        <div class="conyuge">
          <%= image_tag('anillos.gif', :width => '18') %>
          <%= family.otherconsort( son ) %>
        </div>
        </a>
      <% end %>
    </div>
  <% end %>

  </div>
<% end %>

<% if !@person.childrenof.nil? %>
  <% @person.childrenof.consorts.each do |consort| %>
    <% consort.consortof.each do |familia2| %>
      <% if familia2 != @person.childrenof  %>
        <div class="tituloSeccion">
        &#189; hermanos (
        <a href=/tree/familia?f=<%= familia2.id %>>
        <%= consort.name %>
        <%= image_tag('anillos.gif', :width => '18') %>
        <%= ( @person.childrenof.firstOtherconsort( consort ).nil? ? '' : familia2.firstOtherconsort( consort ).name ) %>
        </a>)
        </div>

  <div class="hijos">
    <% familia2.children.sort_by { |a| a[:birthorder]?a[:birthorder]:99 }.each do |son| %>
      <div class="hijo">
        <div class="orden"><%= son.birthorder %></div>
          <a href=?p=<%= son.id %>><div class="hijoNombre"><%= son.name %></div></a>
        <div class="hijoFecha"><%= son.dates %></div>
        <% son.consortof.each do |family| %>
          <a href=familia?f=<%= family.id %>>
          <div class="conyuge">
            <%= image_tag('anillos.gif', :width => '18') %>
            <%= family.otherconsort( son ) %>
          </div>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>

      <% end %>
    <% end %>
  <% end %>
<% end %>
