<% content_for :title, "Familia #{@f.name}" %>
<header>
  <div class="header-left"><%= link_to image_tag('logo.svg', width: 40), tree_fechas_path %></div>
  <div class="header-right"><%= current_user.email.split('@').first %><%= render 'nav_menu' %></div>
</header>
<h1 class="page-title">Familia <%= @f.name %></h1>

<div class="progenitores">

  <% if @f.consorts.length > 0 %>

    <div class="progenitor">
      <a href=/tree/persona?p=<%= @f.consorts[0].id %>>
        <div class="nombreApellidos">
          <%= @f.consorts[0].fullname %>
        </div>
      </a>
      <div class="nacimientoYdefuncion">
        <%= @f.consorts[0].dates %>
      </div>
      <% if @f.consorts[0].childrenof && @f.consorts[0].childrenof.consorts.length > 0 %>
        <% if !@f.consorts[0].childrenof.blank? %>
          <a href=?f=<%= @f.consorts[0].childrenof.id %>>
        <% end %>
        <div class="abuelos">
          <%= @f.consorts[0].childrenof.consorts[0].name %>
          <% if @f.consorts[0].childrenof.consorts.length > 1 %>
            <%= image_tag('anillos.gif', :width => '18') %>
            <%= @f.consorts[0].childrenof.consorts[1].name %>
          <% end %>
        </div>
        <% if !@f.consorts[0].childrenof.blank? %>
          </a>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @f.consorts.length > 1 %>
    <div class="enlace">
      <%= image_tag('anillos.gif', :width => '22') %>
      <% if @f.marriagedate %>
        <br>
        <span class=bodaTitulo>
        <%= IncompleteDate.new(date:@f.marriagedate,accurate:@f.marriagedateAcc).to_s %>
        </span>
      <% end %>
    </div>

    <div class="progenitor">
      <a href=/tree/persona?p=<%= @f.consorts[1].id %>>
        <div class="nombreApellidos">
          <%= @f.consorts[1].fullname %>
        </div>
      </a>
      <div class="nacimientoYdefuncion">
        <%= @f.consorts[1].dates %>
      </div>
      <% if @f.consorts[1].childrenof && @f.consorts[1].childrenof.consorts.length > 0 %>
        <% if !@f.consorts[1].childrenof.blank? %>
          <a href=?f=<%= @f.consorts[1].childrenof.id %>>
        <% end %>
        <div class="abuelos">
          <%= @f.consorts[1].childrenof.consorts[0].name %>
          <% if @f.consorts[1].childrenof.consorts.length > 1 %>
            <%= image_tag('anillos.gif', :width => '18') %>
            <%= @f.consorts[1].childrenof.consorts[1].name %>
          <% end %>
        </div>
        <% if !@f.consorts[1].childrenof.blank? %>
          </a>
        <% end %>
      <% end %>
    </div>
  <% end %>

</div>

<div class="hijos">

<% @f.children.sort_by { |a| a[:birthorder]?a[:birthorder]:99 }.each do |son| %>
  <div class="hijo">
    <div class="orden"><%= son.birthorder %></div>
    <a href=/tree/persona?p=<%= son.id %>><div class="hijoNombre"><%= son.name %></div></a>
    <div class="hijoFecha"><%= son.dates %></div>
    <% son.consortof.each do |family| %>
      <a href=?f=<%= family.id %>>
      <div class="conyuge">
        <%= image_tag('anillos.gif', :width => '18') %>
        <%= family.otherconsort( son ) %>
      </div>
      </a>
    <% end %>
  </div>
<% end %>

</div>



<% if @photos.length > 0 %>
  <% has_other_contour = @photos.any? { |photo| photo.people_photos.any? { |pp| pp.display_points&.any? } } %>
  <div class="tituloSeccion">
  Fotos
  <%= render 'contour_mode_select', has_prota_contour: false, has_other_contour: has_other_contour, highlight_name: nil %>
  </div>
  <div class="hijos">
  <% @photos.sort_by { |p| p.date || Date.new(0) }.each do |photo| %>
    <div class="foto">
      <div class="tituloFoto">
        <%= link_to photo.title, tree_foto_path(id: photo.id, f: @f.id) %>
      </div>
      <% if !photo.date.blank? || !photo.place.blank? %>
        <div class="fechaFoto">
          <%= IncompleteDate.new(date:photo.date,accurate:photo.dateAcc).to_s %>
          <%= photo.place %>
        </div>
      <% end %>
      <%= render 'photo_contours', photo: photo, highlight_person: nil, image_link_path: tree_foto_path(id: photo.id, f: @f.id) %>
      <% if !photo.owner.blank? %>
        <div class="divOwner">
          Foto de <%= photo.owner %>
        </div>
      <% end %>
    </div>
  <% end %>
  </div>

  <%= render 'contour_scripts', highlight_person_id: nil %>
<% end %>
